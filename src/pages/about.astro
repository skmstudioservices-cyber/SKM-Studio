---
import Base from '../layouts/Base.astro';
import '../styles/global.css';
---
<Base title="About — SKM Studio" description="SKM Studio Network is an independent studio building India-focused data sites, near-me directories and free tools.">
  <section class="wrap pt-10 pb-20 max-w-3xl">
    <h1 class="text-3xl md:text-5xl font-bold tracking-tight">About</h1>
    <p class="mt-6 mute leading-relaxed">
      SKM Studio Network is an independent studio run by Subham Maddheshiya. The work is simple:
      take public data that Indians actually need — pincodes, exam results, nearby services —
      and make it fast, searchable and free.
    </p>
    <p class="mt-4 mute leading-relaxed">
      Everything is built on the open web: Astro for the pages, Cloudflare for the edge,
      OpenStreetMap for the map data. No paywalls, no forced sign-ups, no app installs.
    </p>
    <div class="card p-6 mt-8">
      <h2 class="font-semibold">Contact</h2>
      <p class="mt-2 text-sm mute">skmstudio.services@gmail.com</p>
    </div>
  </section>
</Base>
