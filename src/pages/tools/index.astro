---
import Base from '../../layouts/Base.astro';
import '../../styles/global.css';

const tools = [
  { name: 'GST Invoice Calculator', desc: 'Split CGST/SGST/IGST correctly for any Indian invoice value.', soon: true },
  { name: 'Freelance Tax Estimator', desc: 'Estimate tax on freelance income under the new regime.', soon: true },
  { name: 'Pincode Lookup', desc: 'Find the post office, district and state for any Indian pincode.', url: 'https://digipincode.india-in.workers.dev/' },
  { name: 'DIGIPIN Decoder', desc: 'Decode India Post DIGIPIN codes to a precise location.', url: 'https://digipincode.india-in.workers.dev/digipin/' },
  { name: 'Exam Result Finder', desc: 'Search live sarkari results, admit cards and answer keys.', url: 'https://examstatus.india-in.workers.dev/' },
  { name: 'Nearby ATMs', desc: 'Find ATMs around you on a live map.', url: 'https://atmsnearme.pages.dev/' },
];
---
<Base title="Free Tools — SKM Studio" description="Free browser tools from SKM Studio: pincode lookup, DIGIPIN decoding, exam results, calculators and near-me finders.">
  <section class="wrap pt-10 pb-10">
    <h1 class="text-3xl md:text-5xl font-bold tracking-tight">Free tools</h1>
    <p class="mt-4 mute max-w-2xl">Everything runs in your browser. No sign-up, no uploads, no tracking of what you type.</p>
  </section>
  <section class="wrap pb-20">
    <div class="grid gap-4 md:grid-cols-2">
      {tools.map((t) => (
        <div class="card p-6">
          <div class="flex items-start justify-between gap-3">
            <h2 class="font-semibold">{t.name}</h2>
            {t.soon ? <span class="text-xs mute">soon</span> : null}
          </div>
          <p class="mt-2 text-sm mute">{t.desc}</p>
          {t.url ? <a href={t.url} class="inline-block mt-4 text-sm" style="color:var(--color-accent)">Open →</a> : null}
        </div>
      ))}
    </div>
  </section>
</Base>
